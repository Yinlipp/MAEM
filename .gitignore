*.pyc
*.pyo
*.pyd

# Logs and results
*.log
*.pkl
*.npz

# IDE
.vscode/
.idea/
.serena/

# Images / media
*.jpg
*.jpeg
*.png
*.mp4
*.avi

# Allow figs/
!figs/
